rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMemberOfOrg(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)) ||
        getUserData().organizationId == orgId ||
        request.auth.token.admin == true
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'ROLE_ADMIN' || 
        getUserData().role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isManager() {
      return isAuthenticated() && (
        getUserData().role == 'ROLE_MANAGER' || 
        getUserData().role == 'teamLeader' || 
        getUserData().role == 'team_leader' || 
        getUserData().role == 'manager'
      );
    }

    // Rules for 'users' collection (ORGANIZATION ISOLATION ENFORCED)
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId))
      );
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isManager());
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        (resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager())) ||
        request.auth.token.admin == true
      );
      allow delete: if isAuthenticated() && (isAdmin() || request.auth.token.admin == true);
    }

    // Rules for 'organizations' collection
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && isMemberOfOrg(orgId);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isMemberOfOrg(orgId) && isAdmin();
    }

    // Rules for 'organizationMembers' collection
    match /organizationMembers/{memberDocId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        (resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId))
      );
      allow create, update, delete: if isAuthenticated() && (
        (request.resource.data.organizationId != null && isMemberOfOrg(request.resource.data.organizationId) && (isAdmin() || isManager())) ||
        (resource != null && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager()))
      );
    }

    // Rules for 'invitations' collection
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        (resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId))
      );
      allow create, update, delete: if isAuthenticated() && (
        (request.resource.data.organizationId != null && isMemberOfOrg(request.resource.data.organizationId) && (isAdmin() || isManager())) ||
        (resource != null && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager()))
      );
    }

    // Rules for 'team_invitations' collection
    match /team_invitations/{invId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isManager());
    }

    // Rules for 'projects' collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && request.resource.data.organizationId != null && isMemberOfOrg(request.resource.data.organizationId) && (isAdmin() || isManager());
      allow update, delete: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager());
    }

    // Rules for 'tasks' collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && request.resource.data.organizationId != null && isMemberOfOrg(request.resource.data.organizationId);
      allow update: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId);
      allow delete: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager());
    }

    // Rules for 'teams' collection
    match /teams/{teamId} {
      allow read: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId);
      allow create: if isAuthenticated() && request.resource.data.organizationId != null && isMemberOfOrg(request.resource.data.organizationId) && (isAdmin() || isManager());
      allow update, delete: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager());
    }

    // Rules for 'notifications' collection (STRICT RECIPIENT & ORGANIZATION ISOLATION)
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && (
        (resource.data.recipientId == request.auth.uid || resource.data.recipientUid == request.auth.uid || resource.data.userId == request.auth.uid) &&
        (resource.data.organizationId == null || isMemberOfOrg(resource.data.organizationId))
      );
      allow create: if isAuthenticated();
    }

    // Rules for 'userDevices' collection (FCM Android Push Registry)
    match /userDevices/{deviceId} {
      allow read, write, delete: if isAuthenticated() && (
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        deviceId.matches(request.auth.uid + '.*')
      );
    }

    // Rules for 'audit_logs' collection
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager());
      allow create: if isAuthenticated();
    }

    // Rules for 'conversations' collection (ORGANIZATION ISOLATION ENFORCED)
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (
        resource.data.organizationId != null &&
        isMemberOfOrg(resource.data.organizationId)
      ) && (
        resource.data.participants == null ||
        request.auth.uid in resource.data.participants ||
        isAdmin() ||
        isManager()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.organizationId != null &&
        isMemberOfOrg(request.resource.data.organizationId)
      );
      allow update: if isAuthenticated() && (
        resource.data.organizationId != null &&
        isMemberOfOrg(resource.data.organizationId)
      );
      allow delete: if isAuthenticated() && resource.data.organizationId != null && isMemberOfOrg(resource.data.organizationId) && (isAdmin() || isManager());
    }

    // Rules for 'messages' collection (ORGANIZATION ISOLATION ENFORCED)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.organizationId != null &&
        isMemberOfOrg(resource.data.organizationId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.organizationId != null &&
        isMemberOfOrg(request.resource.data.organizationId)
      );
      allow update: if isAuthenticated() && (
        resource.data.organizationId != null &&
        isMemberOfOrg(resource.data.organizationId)
      ) && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin() ||
        isManager()
      );
      allow delete: if isAuthenticated() && (
        resource.data.organizationId != null &&
        isMemberOfOrg(resource.data.organizationId)
      ) && (
        resource.data.senderId == request.auth.uid ||
        isAdmin() ||
        isManager()
      );
    }

    // Rules for 'typing' collection
    match /typing/{typingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'taskSubmissions' collection
    match /taskSubmissions/{subId} {
      allow read, write: if isAuthenticated();
    }

    // Rules for 'calls' collection (WebRTC Signaling for Real-Time Video/Audio Calls)
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}

